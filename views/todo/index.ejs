<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TODOアプリ (V1)</title>
  <style>
    body {
      font-family: sans-serif;
      max-width: 600px;
      margin: 40px auto;
      padding: 0 16px;
      line-height: 1.6;
    }
    .nav {
      margin-bottom: 20px;
      font-size: 0.9rem;
    }
    form {
      display: flex;
      gap: 8px;
      margin-bottom: 16px;
    }
    input[type="text"] {
      flex: 1;
      padding: 8px;
      font-size: 1rem;
    }
    button[type="submit"] {
      padding: 8px 16px;
      font-size: 1rem;
      cursor: pointer;
    }
    #error-area {
      display: none;
      background: #fee2e2;
      color: #b91c1c;
      padding: 10px;
      border-radius: 4px;
      margin-bottom: 12px;
    }
    #status-area {
      color: #555;
      font-size: 0.9rem;
      min-height: 1.4em;
      margin-bottom: 8px;
    }
    #todo-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
  </style>
</head>
<body>
  <div class="nav">
    <a href="/">トップページへ戻る</a>
  </div>

  <h1>TODOアプリ (V1)</h1>

  <form id="todo-form">
    <input
      type="text"
      id="todo-title"
      placeholder="新しいTODOを入力（1〜100文字）"
      autocomplete="off"
    >
    <button type="submit" id="todo-submit">追加</button>
  </form>

  <div id="error-area" role="alert"></div>
  <div id="status-area"></div>

  <p id="empty-message" style="display: none; color: #666;">TODOがありません</p>
  <ul id="todo-list"></ul>

  <script src="/todo/todo.js"></script>
</body>
</html>